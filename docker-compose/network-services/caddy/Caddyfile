# Reverse proxy for the homelab services (replaces Nginx Proxy Manager).
#
# The route table lives in the (routes) snippet below: one line per hostname
# from the DNS plan, pointing at the container that runs the service. Both the
# HTTPS site and the plain HTTP site
# import it, so the Cloudflare tunnel can use either origin.
{
	email admin@neophantom.com
	# Site addresses are declared explicitly, so no redirect server is created.
	auto_https disable_redirects
}

# Certificates come from Let's Encrypt through the Cloudflare DNS-01
# challenge, which also lets Caddy issue the *.neophantom.com wildcard in
# one go (the API token is injected as an environment variable).
(routes) {
	map {host} {backend} {
		# Blocky has no web UI; this serves its API, DoH (/dns-query) and metrics.
		adguard.neophantom.com 192.168.10.3:4000
		bazarr.neophantom.com 192.168.10.20:6767
		calibre.neophantom.com 192.168.10.20:8082
		downloadmovies.neophantom.com 192.168.10.20:5055
		downloadmusic.neophantom.com 192.168.10.20:5030
		prowlarr.neophantom.com 192.168.10.20:9696
		radarr.neophantom.com 192.168.10.20:7878
		sonarr.neophantom.com 192.168.10.20:8989
		soulsync.neophantom.com 192.168.10.20:8008
		# Filebrowser, on the cloud container: this is what the old
		# cloud.neophantom.com DNS record pointed at.
		cloud.neophantom.com 192.168.10.25:80
		torrent.neophantom.com 192.168.10.20:8080
		movies.neophantom.com 192.168.10.21:8096
		komga.neophantom.com 192.168.10.21:25600
		music.neophantom.com 192.168.10.21:4533
		immich.neophantom.com 192.168.10.22:2283
		password.neophantom.com 192.168.10.23:8000
		sync.neophantom.com 192.168.10.25:8384
		grafana.neophantom.com 192.168.10.10:3000
	}

	reverse_proxy {backend}
}

https://*.neophantom.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# The zone lookup must not use the lab resolver: Blocky answers every
		# *.neophantom.com name itself, so the plugin cannot see the NS records.
	}
	import routes
}

http://*.neophantom.com {
	import routes
}

# Served by another host or not deployed yet: redlib, asic (HiveOn Hub).
# Kept internal on purpose: prometheus -> 192.168.10.10:9090,
# files -> 192.168.10.25:80 (Filebrowser), calendar -> 192.168.10.24:5232.
